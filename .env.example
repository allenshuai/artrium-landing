# Copy to .env.local and fill in. Never commit real values.
# Every key below is read somewhere in app/ — see `grep -r process.env app`.

# Ticket Center portal (/ticketcenter)
TICKETCENTER_PASSWORD=
TICKETCENTER_COOKIE_SECRET=
# Lead passcodes, formatted "Name:passcode,Name2:passcode2"
TICKETCENTER_LEADS=

# Exhibition dev portal (/dev/exhibition)
DEV_EXHIBITION_PASSWORD=
DEV_EXHIBITION_COOKIE_SECRET=
# Vercel Blob store for saved imports. Required in production; without it
# `next dev` falls back to a local .local-imports/ directory.
BLOB_READ_WRITE_TOKEN=

# Google Sheets backing store for the Ticket Center
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Map pins: proxied to the Artrium app API, geocoded via Mapbox
ARTRIUM_API_BASE_URL=
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Waitlist form target
WAITLIST_SCRIPT_URL=

# Visitor 3D gallery
NEXT_PUBLIC_GALLERY_MODEL_URL=
NEXT_PUBLIC_GALLERY_ROUTE_SLUG=
