# Copy to .env.local and fill in. Never commit real values.
# Every key below is read somewhere in app/ — see `grep -r process.env app`.

# Ticket Center portal (/ticketcenter)
TICKETCENTER_PASSWORD=
TICKETCENTER_COOKIE_SECRET=
# Lead passcodes, formatted "Name:passcode,Name2:passcode2"
TICKETCENTER_LEADS=

# Exhibition dev portal (/dev/exhibition)
DEV_EXHIBITION_PASSWORD=
DEV_EXHIBITION_COOKIE_SECRET=
# Vercel Blob store for saved imports. In production, connect a Blob store to
# the Vercel project: that sets BLOB_STORE_ID, and the SDK authenticates with the
# OIDC token Vercel injects at runtime. BLOB_READ_WRITE_TOKEN is only for code
# running outside Vercel. Both are trimmed; a blank value counts as unset.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Which store the portal uses. `next dev` uses the gitignored .local-imports/
# directory, even when `vercel env pull` has written BLOB_STORE_ID and
# VERCEL_OIDC_TOKEN into .env.local, so a local session never writes to the
# store the deployed portal reads. A production build (a deployment, or
# `next start`) uses the Blob store and answers 503 without one; VERCEL=1 is not
# needed. The exception is VERCEL_ENV=development, which `vercel env pull`
# writes for the development environment: that build is local too.
# Set to 1 to use the Blob store from either kind of local run; it then needs
# credentials from above. Any other value is ignored.
# WARNING: a local production build run after
# `vercel env pull --environment=production` has VERCEL_ENV=production and the
# production store's credentials, so it WILL read and write the production
# store, with or without this flag. That is what pulling production means.
DEV_EXHIBITION_USE_BLOB=

# Google Sheets backing store for the Ticket Center
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Map pins: proxied to the Artrium app API, geocoded via Mapbox
ARTRIUM_API_BASE_URL=
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Waitlist form target
WAITLIST_SCRIPT_URL=

# Visitor 3D gallery
# The GLB comes from the published map's assetUrl (content/exhibitions/*.json).
# This only overrides it in development, e.g. /local/<file>.glb served from the
# gitignored public/local/. Production ignores it, so a stale value in Vercel
# cannot swap the model under the published map.
NEXT_PUBLIC_GALLERY_MODEL_URL=
# Same rule for the minimap image: the published map names it (minimap.variants),
# and this only stands in during development, e.g. /local/Textured_MiniMap.png.
NEXT_PUBLIC_GALLERY_MINIMAP_URL=
# The gallery's unlisted route, /exhibition/<slug>. Server-only, so it never
# reaches a browser bundle. There is no default: with no slug set, the route 404s.
GALLERY_ROUTE_SLUG=
# Deprecated: the old public name, still read when GALLERY_ROUTE_SLUG is unset.
# NEXT_PUBLIC_ values are inlined into the build, so remove it from Vercel once
# GALLERY_ROUTE_SLUG is set there.
NEXT_PUBLIC_GALLERY_ROUTE_SLUG=
